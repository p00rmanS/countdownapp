<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- shown while the app starts: cream background and the dog -->
    <style name="Theme.Pawcount.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFF8EE</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pawcount</item>
    </style>
    <style name="Theme.Pawcount" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF8EE</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
